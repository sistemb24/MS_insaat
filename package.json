{
  "name": "noa-insaat-yonetim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:seed",
    "build": "next build",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:create": "node scripts/ensure-postgres-database.mjs",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "db:seed": "tsx scripts/seed-default-entities.ts",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "hakedis:import": "node scripts/import-hakedis-opening-balances.mjs",
    "hakedis:scenario:verify": "tsx scripts/verify-construction-simulation-acceptance.ts",
    "hakedis:import:scenario:verify": "tsx scripts/verify-construction-measurement-import-acceptance.ts",
    "isg:acceptance:verify": "tsx scripts/verify-workplace-safety-acceptance.ts",
    "search:benchmark": "tsx scripts/benchmark-global-search.ts",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.4.2",
    "next": "16.2.9",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
