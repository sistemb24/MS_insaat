generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                                    String                                  @id
  name                                  String
  createdAt                             DateTime                                @default(now())
  updatedAt                             DateTime                                @updatedAt
  companies                             Company[]
  sessions                              AppSession[]
  userScopeAccesses                     AppUserScopeAccess[]
  users                                 AppUser[]
  records                               EntityRecord[]
  purchaseInvoices                      PurchaseInvoice[]
  salesInvoices                         SalesInvoice[]
  deliveryNotes                         DeliveryNote[]
  personnelAssets                       PersonnelAssetAssignment[]
  safetyWorkAccidents                   SafetyWorkAccident[]
  safetyTrainings                       SafetyTraining[]
  safetyTrainingAttendances             SafetyTrainingAttendance[]
  safetyInspections                     SafetyInspection[]
  safetyFindings                        SafetyFinding[]
  safetyPpeIssuances                    SafetyPpeIssuance[]
  safetyChecklistTemplates              SafetyChecklistTemplate[]
  safetyChecklistTemplateItems          SafetyChecklistTemplateItem[]
  safetyChecklistRuns                   SafetyChecklistRun[]
  safetyChecklistResponses              SafetyChecklistResponse[]
  supportTickets                        SupportTicket[]
  supportTicketMessages                 SupportTicketMessage[]
  announcements                         Announcement[]
  employeeLeaveRequests                 EmployeeLeaveRequest[]
  employeeLeaveBalances                 EmployeeLeaveBalance[]
  employeeAdvanceRequests               EmployeeAdvanceRequest[]
  employeeAdvanceSettlements            EmployeeAdvanceSettlement[]
  employeeTransfers                     EmployeeTransfer[]
  vehicleAssignments                    VehicleAssignment[]
  vehicleFuelRecords                    VehicleFuelRecord[]
  vehicleMaintenancePlans               VehicleMaintenancePlan[]
  vehicleMaintenanceRecords             VehicleMaintenanceRecord[]
  vehicleTireRecords                    VehicleTireRecord[]
  stockMovements                        StockMovement[]
  progressPayments                      ProgressPayment[]
  constructionProjects                  ConstructionProject[]
  constructionContractItems             ConstructionContractItem[]
  constructionProgressPayments          ConstructionProgressPayment[]
  constructionMeasurementLines          ConstructionMeasurementLine[]
  constructionSnapshots                 ConstructionPaymentItemSnapshot[]
  constructionApprovalEvents            ConstructionApprovalEvent[]
  constructionAccountingLinks           ConstructionAccountingLink[]
  constructionMeasurementSheets         ConstructionMeasurementSheet[]
  constructionExtraWorks                ConstructionExtraWork[]
  constructionDeductionMovements        ConstructionDeductionMovement[]
  constructionDeductionRules            ConstructionDeductionRule[]
  constructionDeductionRuleApplications ConstructionDeductionRuleApplication[]
  constructionFinancialMovements        ConstructionFinancialMovement[]
  constructionPriceRevisions            ConstructionContractItemPriceRevision[]
  constructionSimulationScenarios       ConstructionSimulationScenario[]
  constructionMeasurementImportBatches  ConstructionMeasurementImportBatch[]
  expenses                              Expense[]
  timesheets                            Timesheet[]
  payrollAccruals                       PayrollAccrual[]
  cheques                               Cheque[]
  cashBankMovements                     CashBankMovement[]
  tenders                               Tender[]
  documentFolders                       DocumentFolder[]
  documentFiles                         DocumentFile[]
  notifications                         Notification[]
  notificationPreferences               NotificationPreference[]
  stockMinimumSettings                  StockMinimumSetting[]
  financeSettings                       FinanceSetting[]
  companyProfiles                       CompanyProfile[]
  companyLocations                      CompanyLocation[]
  companyBrandAssets                    CompanyBrandAsset[]
  supplierCategories                    SupplierCategory[]
  customerTypes                         CustomerType[]
  userInvitations                       UserInvitation[]
  emailOutboxMessages                   EmailOutbox[]
  tenantSubscriptions                   TenantSubscription[]
  subscriptionInvoices                  SubscriptionInvoice[]
  subscriptionPaymentWebhookEvents      SubscriptionPaymentWebhookEvent[]
  eFaturaWebhookEvents                  EFaturaWebhookEvent[]
  tenantSubscriptionAddons              TenantSubscriptionAddon[]
  bankIntegrationConnections            BankIntegrationConnection[]
  bankTransactions                      BankTransaction[]
  bankLedgerEntries                     BankLedgerEntry[]
  ledgerEntries                         LedgerEntry[]
  ledgerLines                           LedgerLine[]
  vehicles                              Vehicle[]
  apiKeys                               ApiKey[]
  webhookEndpoints                      WebhookEndpoint[]
  auditLogs                             AuditLog[]
  accessProfiles                        AccessProfile[]
  accessProfileAssignments              UserAccessProfileAssignment[]
}

model Company {
  id                                    String                                  @id
  tenantId                              String
  name                                  String
  createdAt                             DateTime                                @default(now())
  updatedAt                             DateTime                                @updatedAt
  tenant                                Tenant                                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods                               Period[]
  sessions                              AppSession[]
  userScopeAccesses                     AppUserScopeAccess[]
  records                               EntityRecord[]
  purchaseInvoices                      PurchaseInvoice[]
  salesInvoices                         SalesInvoice[]
  deliveryNotes                         DeliveryNote[]
  personnelAssets                       PersonnelAssetAssignment[]
  safetyWorkAccidents                   SafetyWorkAccident[]
  safetyTrainings                       SafetyTraining[]
  safetyTrainingAttendances             SafetyTrainingAttendance[]
  safetyInspections                     SafetyInspection[]
  safetyFindings                        SafetyFinding[]
  safetyPpeIssuances                    SafetyPpeIssuance[]
  safetyChecklistTemplates              SafetyChecklistTemplate[]
  safetyChecklistTemplateItems          SafetyChecklistTemplateItem[]
  safetyChecklistRuns                   SafetyChecklistRun[]
  safetyChecklistResponses              SafetyChecklistResponse[]
  supportTickets                        SupportTicket[]
  supportTicketMessages                 SupportTicketMessage[]
  announcements                         Announcement[]
  employeeLeaveRequests                 EmployeeLeaveRequest[]
  employeeLeaveBalances                 EmployeeLeaveBalance[]
  employeeAdvanceRequests               EmployeeAdvanceRequest[]
  employeeAdvanceSettlements            EmployeeAdvanceSettlement[]
  employeeTransfers                     EmployeeTransfer[]
  vehicleAssignments                    VehicleAssignment[]
  vehicleFuelRecords                    VehicleFuelRecord[]
  vehicleMaintenancePlans               VehicleMaintenancePlan[]
  vehicleMaintenanceRecords             VehicleMaintenanceRecord[]
  vehicleTireRecords                    VehicleTireRecord[]
  stockMovements                        StockMovement[]
  progressPayments                      ProgressPayment[]
  constructionProjects                  ConstructionProject[]
  constructionContractItems             ConstructionContractItem[]
  constructionProgressPayments          ConstructionProgressPayment[]
  constructionMeasurementLines          ConstructionMeasurementLine[]
  constructionSnapshots                 ConstructionPaymentItemSnapshot[]
  constructionApprovalEvents            ConstructionApprovalEvent[]
  constructionAccountingLinks           ConstructionAccountingLink[]
  constructionMeasurementSheets         ConstructionMeasurementSheet[]
  constructionExtraWorks                ConstructionExtraWork[]
  constructionDeductionMovements        ConstructionDeductionMovement[]
  constructionDeductionRules            ConstructionDeductionRule[]
  constructionDeductionRuleApplications ConstructionDeductionRuleApplication[]
  constructionFinancialMovements        ConstructionFinancialMovement[]
  constructionPriceRevisions            ConstructionContractItemPriceRevision[]
  constructionSimulationScenarios       ConstructionSimulationScenario[]
  constructionMeasurementImportBatches  ConstructionMeasurementImportBatch[]
  expenses                              Expense[]
  timesheets                            Timesheet[]
  payrollAccruals                       PayrollAccrual[]
  cheques                               Cheque[]
  cashBankMovements                     CashBankMovement[]
  tenders                               Tender[]
  documentFolders                       DocumentFolder[]
  documentFiles                         DocumentFile[]
  notifications                         Notification[]
  stockMinimumSettings                  StockMinimumSetting[]
  financeSettings                       FinanceSetting[]
  profiles                              CompanyProfile[]
  locations                             CompanyLocation[]
  brandAssets                           CompanyBrandAsset[]
  supplierCategories                    SupplierCategory[]
  customerTypes                         CustomerType[]
  userInvitations                       UserInvitation[]
  emailOutboxMessages                   EmailOutbox[]
  tenantSubscriptions                   TenantSubscription[]
  subscriptionInvoices                  SubscriptionInvoice[]
  subscriptionPaymentWebhookEvents      SubscriptionPaymentWebhookEvent[]
  eFaturaWebhookEvents                  EFaturaWebhookEvent[]
  tenantSubscriptionAddons              TenantSubscriptionAddon[]
  bankIntegrationConnections            BankIntegrationConnection[]
  bankTransactions                      BankTransaction[]
  bankLedgerEntries                     BankLedgerEntry[]
  ledgerEntries                         LedgerEntry[]
  ledgerLines                           LedgerLine[]
  vehicles                              Vehicle[]
  apiKeys                               ApiKey[]
  webhookEndpoints                      WebhookEndpoint[]
  auditLogs                             AuditLog[]
  accessProfiles                        AccessProfile[]
  accessProfileAssignments              UserAccessProfileAssignment[]

  @@index([tenantId])
}

model Period {
  id                                    String                                  @id
  tenantId                              String
  companyId                             String
  label                                 String
  startsAt                              DateTime?
  endsAt                                DateTime?
  createdAt                             DateTime                                @default(now())
  updatedAt                             DateTime                                @updatedAt
  isClosed                              Boolean                                 @default(false)
  company                               Company                                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions                              AppSession[]
  userScopeAccesses                     AppUserScopeAccess[]
  records                               EntityRecord[]
  purchaseInvoices                      PurchaseInvoice[]
  salesInvoices                         SalesInvoice[]
  deliveryNotes                         DeliveryNote[]
  personnelAssets                       PersonnelAssetAssignment[]
  safetyWorkAccidents                   SafetyWorkAccident[]
  safetyTrainings                       SafetyTraining[]
  safetyTrainingAttendances             SafetyTrainingAttendance[]
  safetyInspections                     SafetyInspection[]
  safetyFindings                        SafetyFinding[]
  safetyPpeIssuances                    SafetyPpeIssuance[]
  safetyChecklistTemplates              SafetyChecklistTemplate[]
  safetyChecklistTemplateItems          SafetyChecklistTemplateItem[]
  safetyChecklistRuns                   SafetyChecklistRun[]
  safetyChecklistResponses              SafetyChecklistResponse[]
  supportTickets                        SupportTicket[]
  supportTicketMessages                 SupportTicketMessage[]
  announcements                         Announcement[]
  employeeLeaveRequests                 EmployeeLeaveRequest[]
  employeeLeaveBalances                 EmployeeLeaveBalance[]
  employeeAdvanceRequests               EmployeeAdvanceRequest[]
  employeeAdvanceSettlements            EmployeeAdvanceSettlement[]
  employeeTransfers                     EmployeeTransfer[]
  vehicleAssignments                    VehicleAssignment[]
  vehicleFuelRecords                    VehicleFuelRecord[]
  vehicleMaintenancePlans               VehicleMaintenancePlan[]
  vehicleMaintenanceRecords             VehicleMaintenanceRecord[]
  vehicleTireRecords                    VehicleTireRecord[]
  stockMovements                        StockMovement[]
  progressPayments                      ProgressPayment[]
  constructionProjects                  ConstructionProject[]
  constructionContractItems             ConstructionContractItem[]
  constructionProgressPayments          ConstructionProgressPayment[]
  constructionMeasurementLines          ConstructionMeasurementLine[]
  constructionSnapshots                 ConstructionPaymentItemSnapshot[]
  constructionApprovalEvents            ConstructionApprovalEvent[]
  constructionAccountingLinks           ConstructionAccountingLink[]
  constructionMeasurementSheets         ConstructionMeasurementSheet[]
  constructionExtraWorks                ConstructionExtraWork[]
  constructionDeductionMovements        ConstructionDeductionMovement[]
  constructionDeductionRules            ConstructionDeductionRule[]
  constructionDeductionRuleApplications ConstructionDeductionRuleApplication[]
  constructionFinancialMovements        ConstructionFinancialMovement[]
  constructionPriceRevisions            ConstructionContractItemPriceRevision[]
  constructionSimulationScenarios       ConstructionSimulationScenario[]
  constructionMeasurementImportBatches  ConstructionMeasurementImportBatch[]
  expenses                              Expense[]
  timesheets                            Timesheet[]
  payrollAccruals                       PayrollAccrual[]
  cheques                               Cheque[]
  cashBankMovements                     CashBankMovement[]
  tenders                               Tender[]
  documentFolders                       DocumentFolder[]
  documentFiles                         DocumentFile[]
  notifications                         Notification[]
  stockMinimumSettings                  StockMinimumSetting[]
  financeSettings                       FinanceSetting[]
  userInvitations                       UserInvitation[]
  emailOutboxMessages                   EmailOutbox[]
  tenantSubscriptions                   TenantSubscription[]
  subscriptionInvoices                  SubscriptionInvoice[]
  subscriptionPaymentWebhookEvents      SubscriptionPaymentWebhookEvent[]
  eFaturaWebhookEvents                  EFaturaWebhookEvent[]
  tenantSubscriptionAddons              TenantSubscriptionAddon[]
  bankIntegrationConnections            BankIntegrationConnection[]
  bankTransactions                      BankTransaction[]
  bankLedgerEntries                     BankLedgerEntry[]
  ledgerEntries                         LedgerEntry[]
  ledgerLines                           LedgerLine[]
  vehicles                              Vehicle[]
  apiKeys                               ApiKey[]
  webhookEndpoints                      WebhookEndpoint[]
  auditLogs                             AuditLog[]
  accessProfileAssignments              UserAccessProfileAssignment[]

  @@index([tenantId, companyId])
}

model AppUser {
  id                       String                        @id
  tenantId                 String
  name                     String
  email                    String?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt
  tenant                   Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential               AppCredential?
  sessions                 AppSession[]
  authSessions             AppAuthSession[]
  userScopeAccesses        AppUserScopeAccess[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  accessProfileAssignments UserAccessProfileAssignment[]

  @@index([tenantId])
}

model AppCredential {
  id               String     @id @default(cuid())
  tenantId         String
  userId           String     @unique
  email            String     @unique
  passwordHash     String
  defaultSessionId String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultSession   AppSession @relation(fields: [defaultSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AppSession {
  id           String          @id
  tenantId     String
  companyId    String
  periodId     String
  userId       String
  role         String
  licenseLabel String
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       Period          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user         AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials  AppCredential[]
  authSessions AppAuthSession[]

  @@index([tenantId, userId])
  @@index([tenantId, companyId, periodId])
}

model AppAuthSession {
  id             String     @id
  userId         String
  scopeSessionId String
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopeSession   AppSession @relation(fields: [scopeSessionId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([scopeSessionId])
  @@index([expiresAt])
}

model TenantLoginRateLimitBucket {
  id              String   @id
  scopeKind       String
  scopeHash       String
  windowStartedAt DateTime
  windowEndsAt    DateTime
  requestCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([scopeKind, scopeHash, windowStartedAt])
  @@index([windowEndsAt])
}

model AppUserScopeAccess {
  id           String   @id
  tenantId     String
  companyId    String
  periodId     String
  userId       String
  role         String
  licenseLabel String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, periodId])
  @@index([tenantId, userId, isActive])
  @@index([tenantId, companyId, periodId])
}

model AccessProfile {
  id              String                        @id
  tenantId        String
  companyId       String
  name            String
  normalizedName  String
  description     String
  status          String                        @default("ACTIVE")
  revisionNo      Int                           @default(1)
  lastMutationKey String
  createdBy       String
  updatedBy       String
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company                       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions     AccessProfilePermission[]
  assignments     UserAccessProfileAssignment[]
  invitations     UserInvitation[]

  @@unique([tenantId, companyId, normalizedName])
  @@index([tenantId, companyId, status])
}

model AccessProfilePermission {
  profileId      String
  permissionCode String
  allowed        Boolean       @default(false)
  profile        AccessProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, permissionCode])
  @@index([permissionCode])
}

model UserAccessProfileAssignment {
  id              String        @id
  tenantId        String
  companyId       String
  periodId        String
  userId          String
  profileId       String
  revisionNo      Int           @default(1)
  lastMutationKey String
  createdBy       String
  updatedBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period          Period        @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user            AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         AccessProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([tenantId, companyId, periodId, userId])
  @@index([tenantId, companyId, profileId])
}

model EntityRecord {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  periodId  String
  slug      String
  code      String
  data      Json
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, periodId, slug, code])
  @@index([tenantId, companyId, periodId, slug])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  periodId    String
  actorUserId String
  action      String
  entityType  String
  entityId    String
  entityLabel String
  metadata    Json
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, occurredAt])
}

model FinanceSetting {
  id               String   @id
  tenantId         String
  companyId        String
  periodId         String
  defaultVatRate   Decimal  @db.Decimal(5, 2)
  showVatBreakdown Boolean  @default(true)
  revisionNo       Int      @default(1)
  lastMutationKey  String?  @db.VarChar(500)
  createdBy        String
  updatedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, periodId])
  @@index([tenantId, companyId, periodId, updatedAt])
}

model CompanyProfile {
  id              String   @id
  tenantId        String
  companyId       String
  legalName       String   @db.VarChar(200)
  taxOffice       String   @default("") @db.VarChar(100)
  taxNumber       String   @default("") @db.VarChar(11)
  mersisNumber    String   @default("") @db.VarChar(16)
  phone           String   @default("") @db.VarChar(30)
  email           String   @default("") @db.VarChar(254)
  addressLine     String   @default("") @db.VarChar(300)
  district        String   @default("") @db.VarChar(100)
  city            String   @default("") @db.VarChar(100)
  postalCode      String   @default("") @db.VarChar(10)
  revisionNo      Int      @default(1)
  lastMutationKey String?  @db.VarChar(500)
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId])
  @@index([tenantId, companyId, updatedAt])
}

model CompanyLocation {
  id                String   @id
  tenantId          String
  companyId         String
  code              String   @db.VarChar(30)
  name              String   @db.VarChar(160)
  type              String   @db.VarChar(20)
  responsiblePerson String   @default("") @db.VarChar(160)
  phone             String   @default("") @db.VarChar(30)
  email             String   @default("") @db.VarChar(254)
  addressLine       String   @default("") @db.VarChar(300)
  district          String   @default("") @db.VarChar(100)
  city              String   @default("") @db.VarChar(100)
  postalCode        String   @default("") @db.VarChar(10)
  status            String   @default("ACTIVE") @db.VarChar(20)
  revisionNo        Int      @default(1)
  lastMutationKey   String?  @db.VarChar(500)
  createdBy         String
  updatedBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId, type, status])
  @@index([tenantId, companyId, updatedAt])
}

model CompanyBrandAsset {
  id               String   @id
  tenantId         String
  companyId        String
  mimeType         String?  @db.VarChar(50)
  originalFileName String   @default("") @db.VarChar(180)
  sizeBytes        Int      @default(0)
  width            Int?
  height           Int?
  sha256           String   @default("") @db.VarChar(64)
  content          Bytes?
  status           String   @default("ACTIVE") @db.VarChar(20)
  revisionNo       Int      @default(1)
  lastMutationKey  String?  @db.VarChar(500)
  createdBy        String
  updatedBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId])
  @@index([tenantId, companyId, status, updatedAt])
}

model SupplierCategory {
  id              String   @id
  tenantId        String
  companyId       String
  name            String   @db.VarChar(80)
  normalizedName  String   @db.VarChar(80)
  description     String   @default("") @db.VarChar(240)
  status          String   @default("ACTIVE") @db.VarChar(16)
  revisionNo      Int      @default(1)
  lastMutationKey String?  @db.VarChar(500)
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, normalizedName])
  @@index([tenantId, companyId, status, name])
}

model CustomerType {
  id              String   @id
  tenantId        String
  companyId       String
  name            String   @db.VarChar(80)
  normalizedName  String   @db.VarChar(80)
  description     String   @default("") @db.VarChar(240)
  status          String   @default("ACTIVE") @db.VarChar(16)
  revisionNo      Int      @default(1)
  lastMutationKey String?  @db.VarChar(500)
  createdBy       String
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, normalizedName])
  @@index([tenantId, companyId, status, name])
}

model Notification {
  id          String    @id
  tenantId    String
  companyId   String
  periodId    String
  userId      String
  category    String
  title       String
  body        String
  priority    String
  readAt      DateTime?
  targetHref  String
  targetLabel String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, userId, createdAt])
  @@index([tenantId, companyId, periodId, userId, readAt])
  @@index([tenantId, companyId, periodId, userId, category])
}

model NotificationPreference {
  id           String   @id
  tenantId     String
  userId       String
  category     String
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  pushEnabled  Boolean  @default(false)
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category])
  @@index([tenantId, userId])
}

model StockMinimumSetting {
  id              String   @id
  tenantId        String
  companyId       String
  periodId        String
  warehouse       String
  stockCode       String?
  stockName       String?
  unit            String
  minimumQuantity Decimal  @db.Decimal(18, 4)
  isActive        Boolean  @default(true)
  updatedBy       String
  createdAt       DateTime @default(now())
