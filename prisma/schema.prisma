  baseType         String?
  rate             Decimal?                               @db.Decimal(9, 4)
  fixedAmount      Decimal?                               @db.Decimal(18, 2)
  minimumAmount    Decimal?                               @db.Decimal(18, 2)
  maximumAmount    Decimal?                               @db.Decimal(18, 2)
  taxMode          String                                 @default("NONE")
  taxRate          Decimal                                @default(0) @db.Decimal(5, 2)
  priority         Int                                    @default(0)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  isActive         Boolean                                @default(true)
  autoApply        Boolean                                @default(false)
  supersedesRuleId String?                                @unique
  createdBy        String
  updatedBy        String
  createdAt        DateTime                               @default(now())
  updatedAt        DateTime                               @updatedAt
  tenant           Tenant                                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company                                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           Period                                 @relation(fields: [periodId], references: [id], onDelete: Cascade)
  project          ConstructionProject                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supersedesRule   ConstructionDeductionRule?             @relation("ConstructionDeductionRuleRevisions", fields: [supersedesRuleId], references: [id])
  nextRevisions    ConstructionDeductionRule[]            @relation("ConstructionDeductionRuleRevisions")
  applications     ConstructionDeductionRuleApplication[]

  @@unique([projectId, ruleKey, revisionNo])
  @@unique([projectId, code, revisionNo])
  @@index([tenantId, companyId, periodId, projectId, isActive])
  @@index([projectId, effectiveFrom, effectiveTo])
}

