  deductionMovementId String                        @unique
  ruleKey             String
  ruleCode            String
  ruleName            String
  ruleRevisionNo      Int
  calculationType     String
  baseType            String?
  baseAmount          Decimal                       @db.Decimal(18, 2)
  rate                Decimal?                      @db.Decimal(9, 4)
  fixedAmount         Decimal?                      @db.Decimal(18, 2)
  minimumAmount       Decimal?                      @db.Decimal(18, 2)
  maximumAmount       Decimal?                      @db.Decimal(18, 2)
  taxMode             String
  taxRate             Decimal                       @db.Decimal(5, 2)
  taxAmount           Decimal                       @db.Decimal(18, 2)
  netAmount           Decimal                       @db.Decimal(18, 2)
  totalAmount         Decimal                       @db.Decimal(18, 2)
  applicationKey      String                        @unique
  appliedBy           String
  updatedBy           String
