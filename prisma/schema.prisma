// ─── Süper Admin Authentication ───────────────────────────────────────────────

model SuperAdminCredential {
  id           String   @id @default(cuid())
  singletonKey String   @unique @default("platform")
  email        String   @unique
  passwordHash String
  name         String
  is2FAEnabled Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            SuperAdminSession[]
  otpCodes            SuperAdminOtpCode[]
  totpSecret          SuperAdminTotpSecret?
  accountLock         SuperAdminAccountLock?
  passwordResetTokens SuperAdminPasswordResetToken[]
  authChallenges      SuperAdminAuthChallenge[]
}

model SuperAdminSession {
  id           String   @id @default(cuid())
  credentialId String
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  ipAddress    String?
  userAgent    String?

  credential SuperAdminCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([expiresAt])
}

model SuperAdminPasswordResetToken {
  id           String    @id @default(cuid())
  credentialId String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  credential SuperAdminCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([expiresAt])
}

model SuperAdminOtpCode {
  id           String    @id @default(cuid())
  credentialId String
  codeHash     String
  expiresAt    DateTime
  usedAt       DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  credential SuperAdminCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId])
  @@index([expiresAt])
}

model SuperAdminTotpSecret {
  id                  String    @id @default(cuid())
  credentialId        String    @unique
  secretBase32        String?
  secretCiphertext    String?
  secretKeyVersion    String?
  backupCodes         String[]
  enrollmentExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  verifiedAt          DateTime?

  credential SuperAdminCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model SuperAdminAuthChallenge {
  id           String    @id @default(cuid())
  credentialId String
  tokenHash    String    @unique
  purpose      String
  returnTo     String?
  expiresAt    DateTime
  maxAttempts  Int       @default(5)
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  credential SuperAdminCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, purpose, expiresAt])
  @@index([expiresAt])
}

model SuperAdminRateLimitBucket {
  id              String   @id
  purpose         String
  scopeHash       String
  windowStartedAt DateTime
  windowEndsAt    DateTime
  requestCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([purpose, scopeHash, windowStartedAt])
  @@index([windowEndsAt])
}

model SuperAdminAccountLock {
  id             String    @id @default(cuid())
  credentialId   String    @unique
  failedAttempts Int       @default(0)
  lockedAt       DateTime?
  lockedUntil    DateTime?
  lastFailedAt   DateTime?
  lastFailedIp   String?
  updatedAt      DateTime  @updatedAt

  credential SuperAdminCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
}

model MaintenanceConfig {
  id        String    @id @default(cuid())
  isActive  Boolean   @default(false)
  message   String?
  endsAt    DateTime?
  statusUrl String?
  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
}
