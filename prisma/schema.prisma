generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                         String                      @id
  name                       String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  companies                  Company[]
  sessions                   AppSession[]
  userScopeAccesses          AppUserScopeAccess[]
  users                      AppUser[]
  records                    EntityRecord[]
  purchaseInvoices           PurchaseInvoice[]
  salesInvoices              SalesInvoice[]
  deliveryNotes              DeliveryNote[]
  personnelAssets            PersonnelAssetAssignment[]
  stockMovements             StockMovement[]
  progressPayments           ProgressPayment[]
  constructionProjects      ConstructionProject[]
  constructionContractItems ConstructionContractItem[]
  constructionProgressPayments ConstructionProgressPayment[]
  constructionMeasurementLines ConstructionMeasurementLine[]
  constructionSnapshots     ConstructionPaymentItemSnapshot[]
  constructionApprovalEvents ConstructionApprovalEvent[]
  constructionAccountingLinks ConstructionAccountingLink[]
  constructionMeasurementSheets ConstructionMeasurementSheet[]
  constructionExtraWorks ConstructionExtraWork[]
  constructionDeductionMovements ConstructionDeductionMovement[]
  constructionDeductionRules ConstructionDeductionRule[]
  constructionDeductionRuleApplications ConstructionDeductionRuleApplication[]
  constructionFinancialMovements ConstructionFinancialMovement[]
  constructionPriceRevisions ConstructionContractItemPriceRevision[]
  expenses                   Expense[]
  timesheets                 Timesheet[]
  payrollAccruals            PayrollAccrual[]
  cheques                    Cheque[]
  cashBankMovements          CashBankMovement[]
  tenders                    Tender[]
  documentFolders            DocumentFolder[]
  documentFiles              DocumentFile[]
  notifications              Notification[]
  notificationPreferences    NotificationPreference[]
  stockMinimumSettings       StockMinimumSetting[]
  userInvitations            UserInvitation[]
  emailOutboxMessages        EmailOutbox[]
  tenantSubscriptions        TenantSubscription[]
  subscriptionInvoices       SubscriptionInvoice[]
  subscriptionPaymentWebhookEvents SubscriptionPaymentWebhookEvent[]
  eFaturaWebhookEvents      EFaturaWebhookEvent[]
  tenantSubscriptionAddons   TenantSubscriptionAddon[]
  bankIntegrationConnections BankIntegrationConnection[]
  bankTransactions           BankTransaction[]
  bankLedgerEntries          BankLedgerEntry[]
  ledgerEntries              LedgerEntry[]
  ledgerLines                LedgerLine[]
  vehicles                   Vehicle[]
  apiKeys                    ApiKey[]
  webhookEndpoints           WebhookEndpoint[]
  auditLogs                  AuditLog[]
}

model Company {
  id                         String                      @id
  tenantId                   String
  name                       String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  tenant                     Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periods                    Period[]
  sessions                   AppSession[]
  userScopeAccesses          AppUserScopeAccess[]
  records                    EntityRecord[]
  purchaseInvoices           PurchaseInvoice[]
  salesInvoices              SalesInvoice[]
  deliveryNotes              DeliveryNote[]
  personnelAssets            PersonnelAssetAssignment[]
  stockMovements             StockMovement[]
  progressPayments           ProgressPayment[]
  constructionProjects      ConstructionProject[]
  constructionContractItems ConstructionContractItem[]
  constructionProgressPayments ConstructionProgressPayment[]
  constructionMeasurementLines ConstructionMeasurementLine[]
  constructionSnapshots     ConstructionPaymentItemSnapshot[]
  constructionApprovalEvents ConstructionApprovalEvent[]
  constructionAccountingLinks ConstructionAccountingLink[]
  constructionMeasurementSheets ConstructionMeasurementSheet[]
  constructionExtraWorks ConstructionExtraWork[]
  constructionDeductionMovements ConstructionDeductionMovement[]
  constructionDeductionRules ConstructionDeductionRule[]
  constructionDeductionRuleApplications ConstructionDeductionRuleApplication[]
  constructionFinancialMovements ConstructionFinancialMovement[]
  constructionPriceRevisions ConstructionContractItemPriceRevision[]
  expenses                   Expense[]
  timesheets                 Timesheet[]
  payrollAccruals            PayrollAccrual[]
  cheques                    Cheque[]
  cashBankMovements          CashBankMovement[]
  tenders                    Tender[]
  documentFolders            DocumentFolder[]
  documentFiles              DocumentFile[]
  notifications              Notification[]
  stockMinimumSettings       StockMinimumSetting[]
  userInvitations            UserInvitation[]
  emailOutboxMessages        EmailOutbox[]
  tenantSubscriptions        TenantSubscription[]
  subscriptionInvoices       SubscriptionInvoice[]
  subscriptionPaymentWebhookEvents SubscriptionPaymentWebhookEvent[]
  eFaturaWebhookEvents      EFaturaWebhookEvent[]
  tenantSubscriptionAddons   TenantSubscriptionAddon[]
  bankIntegrationConnections BankIntegrationConnection[]
  bankTransactions           BankTransaction[]
  bankLedgerEntries          BankLedgerEntry[]
  ledgerEntries              LedgerEntry[]
  ledgerLines                LedgerLine[]
  vehicles                   Vehicle[]
  apiKeys                    ApiKey[]
  webhookEndpoints           WebhookEndpoint[]
  auditLogs                  AuditLog[]

  @@index([tenantId])
}

model Period {
  id                         String                      @id
  tenantId                   String
  companyId                  String
  label                      String
  startsAt                   DateTime?
  endsAt                     DateTime?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  isClosed                    Boolean                     @default(false)
  company                    Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions                   AppSession[]
  userScopeAccesses          AppUserScopeAccess[]
  records                    EntityRecord[]
  purchaseInvoices           PurchaseInvoice[]
  salesInvoices              SalesInvoice[]
  deliveryNotes              DeliveryNote[]
  personnelAssets            PersonnelAssetAssignment[]
  stockMovements             StockMovement[]
  progressPayments           ProgressPayment[]
  constructionProjects      ConstructionProject[]
  constructionContractItems ConstructionContractItem[]
  constructionProgressPayments ConstructionProgressPayment[]
  constructionMeasurementLines ConstructionMeasurementLine[]
  constructionSnapshots     ConstructionPaymentItemSnapshot[]
  constructionApprovalEvents ConstructionApprovalEvent[]
  constructionAccountingLinks ConstructionAccountingLink[]
  constructionMeasurementSheets ConstructionMeasurementSheet[]
  constructionExtraWorks ConstructionExtraWork[]
  constructionDeductionMovements ConstructionDeductionMovement[]
  constructionDeductionRules ConstructionDeductionRule[]
  constructionDeductionRuleApplications ConstructionDeductionRuleApplication[]
  constructionFinancialMovements ConstructionFinancialMovement[]
  constructionPriceRevisions ConstructionContractItemPriceRevision[]
  expenses                   Expense[]
  timesheets                 Timesheet[]
  payrollAccruals            PayrollAccrual[]
  cheques                    Cheque[]
  cashBankMovements          CashBankMovement[]
  tenders                    Tender[]
  documentFolders            DocumentFolder[]
  documentFiles              DocumentFile[]
  notifications              Notification[]
  stockMinimumSettings       StockMinimumSetting[]
  userInvitations            UserInvitation[]
  emailOutboxMessages        EmailOutbox[]
  tenantSubscriptions        TenantSubscription[]
  subscriptionInvoices       SubscriptionInvoice[]
  subscriptionPaymentWebhookEvents SubscriptionPaymentWebhookEvent[]
  eFaturaWebhookEvents      EFaturaWebhookEvent[]
  tenantSubscriptionAddons   TenantSubscriptionAddon[]
  bankIntegrationConnections BankIntegrationConnection[]
  bankTransactions           BankTransaction[]
  bankLedgerEntries          BankLedgerEntry[]
  ledgerEntries              LedgerEntry[]
  ledgerLines                LedgerLine[]
  vehicles                   Vehicle[]
  apiKeys                    ApiKey[]
  webhookEndpoints           WebhookEndpoint[]
  auditLogs                  AuditLog[]

  @@index([tenantId, companyId])
}

model AppUser {
  id                      String                   @id
  tenantId                String
  name                    String
  email                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credential              AppCredential?
  sessions                AppSession[]
  userScopeAccesses       AppUserScopeAccess[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@index([tenantId])
}

model AppCredential {
  id               String     @id @default(cuid())
  tenantId         String
  userId           String     @unique
  email            String     @unique
  passwordHash     String
  defaultSessionId String
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  user             AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultSession   AppSession @relation(fields: [defaultSessionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AppSession {
  id           String          @id
  tenantId     String
  companyId    String
  periodId     String
  userId       String
  role         String
  licenseLabel String
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       Period          @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user         AppUser         @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials  AppCredential[]

  @@index([tenantId, userId])
  @@index([tenantId, companyId, periodId])
}

model AppUserScopeAccess {
  id           String   @id
  tenantId     String
  companyId    String
  periodId     String
  userId       String
  role         String
  licenseLabel String
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, periodId])
  @@index([tenantId, userId, isActive])
  @@index([tenantId, companyId, periodId])
}

model EntityRecord {
  id        String   @id @default(cuid())
  tenantId  String
  companyId String
  periodId  String
  slug      String
  code      String
  data      Json
  createdBy String
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period    Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, periodId, slug, code])
  @@index([tenantId, companyId, periodId, slug])
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  companyId   String
  periodId    String
  actorUserId String
  action      String
  entityType  String
  entityId    String
  entityLabel String
  metadata    Json
  occurredAt  DateTime
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, occurredAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, actorUserId, occurredAt])
}

model Notification {
  id          String    @id
  tenantId    String
  companyId   String
  periodId    String
  userId      String
  category    String
  title       String
  body        String
  priority    String
  readAt      DateTime?
  targetHref  String
  targetLabel String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user        AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, userId, createdAt])
  @@index([tenantId, companyId, periodId, userId, readAt])
  @@index([tenantId, companyId, periodId, userId, category])
}

model NotificationPreference {
  id           String   @id
  tenantId     String
  userId       String
  category     String
  inAppEnabled Boolean  @default(true)
  emailEnabled Boolean  @default(false)
  pushEnabled  Boolean  @default(false)
  updatedBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, category])
  @@index([tenantId, userId])
}

model StockMinimumSetting {
  id              String   @id
  tenantId        String
  companyId       String
  periodId        String
  warehouse       String
  stockCode       String?
  stockName       String?
  unit            String
  minimumQuantity Decimal  @db.Decimal(18, 4)
  isActive        Boolean  @default(true)
  updatedBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period          Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, isActive])
  @@index([tenantId, companyId, periodId, warehouse])
}

model UserInvitation {
  id         String    @id
  tenantId   String
  companyId  String
  periodId   String
  email      String
  role       String
  status     String
  tokenHash  String    @unique
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period     Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, status])
  @@index([tenantId, companyId, periodId, email])
  @@index([tenantId, tokenHash])
}

model EmailOutbox {
  id             String    @id
  tenantId       String
  companyId      String
  periodId       String
  channel        String
  recipientEmail String
  subject        String
  bodyText       String
  template       String
  status         String
  metadata       Json
  createdAt      DateTime  @default(now())
  sentAt         DateTime?
  failedAt       DateTime?
  lastError      String?
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([tenantId, companyId, periodId, status, createdAt])
  @@index([tenantId, recipientEmail, createdAt])
}

model SubscriptionPlan {
  id              String               @id
  name            String
  description     String
  monthlyPrice    Decimal              @db.Decimal(18, 2)
  includedModules Json
  userLimit       Int
  storageLimitGb  Int
  sortOrder       Int
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  subscriptions   TenantSubscription[]

  @@index([isActive, sortOrder])
}

model SubscriptionAddon {
  id             String                    @id
  name           String
  description    String
  monthlyPrice   Decimal                   @db.Decimal(18, 2)
  isActive       Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  subscriptions  TenantSubscriptionAddon[]

  @@index([isActive, name])
}

model TenantSubscription {
  id              String                     @id
  tenantId        String
  companyId       String
  periodId        String
  planId          String
  billingCycle    String
  startsAt        DateTime
  endsAt          DateTime
  renewalAmount   Decimal                    @db.Decimal(18, 2)
  autoRenew       Boolean                    @default(true)
  userLimit       Int
  storageLimitGb  Int
  status          String
  createdBy       String
  updatedBy       String
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period          Period                     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  plan            SubscriptionPlan           @relation(fields: [planId], references: [id])
  invoices        SubscriptionInvoice[]
  addons          TenantSubscriptionAddon[]

  @@index([tenantId, companyId, periodId, status])
  @@index([tenantId, planId])
}

model SubscriptionInvoice {
  id             String             @id
  tenantId       String
  companyId      String
  periodId       String
  subscriptionId String
  invoiceNo      String
  invoiceDate    DateTime
  amount         Decimal            @db.Decimal(18, 2)
  currency       String
  status         String
  method         String
  providerRef    String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, periodId, invoiceNo])
  @@index([tenantId, companyId, periodId, invoiceDate])
  @@index([tenantId, companyId, periodId, subscriptionId])
}

model SubscriptionPaymentWebhookEvent {
  id           String    @id @default(cuid())
  tenantId     String
  companyId    String
  periodId     String
  eventId      String
  eventType    String
  invoiceNo    String
  providerRef  String
  status       String
  resultStatus String?
  errorMessage String?
  receivedAt   DateTime
  processedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period       Period    @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId, companyId, periodId, status], map: "SubscriptionPaymentWebhookEvent_scope_status_idx")
  @@index([tenantId, companyId, periodId, invoiceNo], map: "SubscriptionPaymentWebhookEvent_scope_invoiceNo_idx")
  @@index([tenantId, providerRef])
}

model EFaturaWebhookEvent {
  id             String   @id @default(cuid())
  tenantId       String
  companyId      String
  periodId       String
  eventId        String
  eventType      String
  invoiceNo      String
  providerRef    String
  providerStatus String
  receivedAt     DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventId])
  @@index([tenantId, companyId, periodId, receivedAt], map: "EFaturaWebhookEvent_scope_receivedAt_idx")
  @@index([tenantId, companyId, periodId, invoiceNo], map: "EFaturaWebhookEvent_scope_invoiceNo_idx")
}

model TenantSubscriptionAddon {
  id             String             @id
  tenantId       String
  companyId      String
  periodId       String
  subscriptionId String
  addonId        String
  status         String
  startsAt       DateTime
  endsAt         DateTime?
  monthlyPrice   Decimal            @db.Decimal(18, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period         Period             @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon          SubscriptionAddon  @relation(fields: [addonId], references: [id])

  @@unique([tenantId, companyId, periodId, subscriptionId, addonId])
  @@index([tenantId, companyId, periodId, status])
  @@index([tenantId, addonId])
}

model BankIntegrationConnection {
  id              String            @id
  tenantId        String
  companyId       String
  periodId        String
  bankCode        String
  bankName        String
  environment     String
  consentId       String
  status          String
  lastTestStatus  String
  lastTestMessage String
  lastTestedAt    DateTime
  createdBy       String
  updatedBy       String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period          Period            @relation(fields: [periodId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]

  @@unique([tenantId, companyId, periodId, bankCode, environment])
  @@index([tenantId, companyId, periodId, status])
  @@index([tenantId, companyId, periodId, bankCode])
}

model BankTransaction {
  id               String                    @id
  tenantId         String
  companyId        String
  periodId         String
  bankConnectionId String
  bankName         String
  externalId       String
  occurredAt       DateTime
  description      String
  direction        String
  amount           Decimal                   @db.Decimal(18, 2)
  currency         String
  status           String
  updatedAt        DateTime                  @updatedAt
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period           Period                    @relation(fields: [periodId], references: [id], onDelete: Cascade)
  connection       BankIntegrationConnection @relation(fields: [bankConnectionId], references: [id], onDelete: Cascade)
  ledgerEntries    BankLedgerEntry[]

  @@unique([tenantId, companyId, periodId, bankConnectionId, externalId])
  @@index([tenantId, companyId, periodId, occurredAt])
  @@index([tenantId, companyId, periodId, status])
  @@index([bankConnectionId, occurredAt])
}

model BankLedgerEntry {
  id                  String           @id
  tenantId            String
  companyId           String
  periodId            String
  bankTransactionId   String
  cashBankMovementId  String
  entryDate           DateTime
  documentNo          String
  description         String
  cashBankAccountCode String
  cashBankAccountName String
  ledgerDirection     String
  amount              Decimal          @db.Decimal(18, 2)
  currency            String
  status              String
  createdBy           String
  updatedBy           String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period              Period           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  bankTransaction     BankTransaction  @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  cashBankMovement    CashBankMovement @relation(fields: [cashBankMovementId], references: [id], onDelete: Cascade)

  @@unique([tenantId, companyId, periodId, bankTransactionId, cashBankMovementId])
  @@index([tenantId, companyId, periodId, entryDate])
  @@index([tenantId, companyId, periodId, status])
  @@index([tenantId, companyId, periodId, cashBankMovementId, status])
}

model LedgerEntry {
  id          String       @id
  tenantId    String
  companyId   String
  periodId    String
  sourceType  String?
  sourceId    String?
  entryDate   DateTime     @db.Date
  documentNo  String
  description String
  currency    String
  status      String
  debitTotal  Decimal      @db.Decimal(18, 2)
  creditTotal Decimal      @db.Decimal(18, 2)
  createdBy   String
  updatedBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  lines       LedgerLine[]

  @@unique([tenantId, companyId, periodId, documentNo])
  @@unique([tenantId, companyId, periodId, sourceType, sourceId])
  @@index([tenantId, companyId, periodId, entryDate])
  @@index([tenantId, companyId, periodId, status])
}

model LedgerLine {
  id          String      @id
  tenantId    String
  companyId   String
  periodId    String
  entryId     String
  lineNo      Int
  accountCode String
  accountName String
  debit       Decimal     @db.Decimal(18, 2)
  credit      Decimal     @db.Decimal(18, 2)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  period      Period      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  entry       LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, lineNo])
  @@index([tenantId, companyId, periodId, accountCode])
  @@index([entryId])
}

model Vehicle {
  id              String   @id
  tenantId        String
  companyId       String
  periodId        String
  plate           String
  vehicleType     String
  brand           String?
  modelName       String?
  modelYear       Int?
  fuelType        String?
  chassisNumber   String?
  engineNumber    String?
  entryOdometerKm Int?
  acquisitionDate DateTime? @db.Date
  dispositionDate DateTime? @db.Date
